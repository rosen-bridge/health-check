{
  "name": "@rosen-bridge/asset-check",
  "version": "6.0.1",
  "description": "Rosen bridge health check service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/health-check.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^3.9.11",
    "@blockfrost/blockfrost-js": "^6.0.0",
    "@rosen-bridge/health-check": "^8.0.0",
    "@rosen-clients/cardano-koios": "^3.1.1",
    "@rosen-clients/ergo-explorer": "^2.1.1",
    "@rosen-clients/ergo-node": "^3.1.1",
    "@rosen-clients/rate-limited-axios": "^1.1.1",
    "cross-fetch": "^4.0.0",
    "ethers": "6.13.2"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
